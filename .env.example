# --- Database (Turso / LibSQL) ---
TURSO_DATABASE_URL=libsql://your_database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# --- Sesi login (WAJIB di production; min. 32 karakter acak) ---
# Buat dengan: openssl rand -base64 48
SESSION_SECRET=

# --- Admin (pisahkan dengan koma untuk >1 admin) ---
ADMIN_EMAILS=admin@ruanghadir.net

# --- Google Sign-In ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# --- Upload media ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# --- App ---
NEXT_PUBLIC_APP_URL=https://ruanghadir.net

# --- AI penulis narasi (opsional, server-only) ---
GEMINI_API_KEY=

# --- Enterprise (opsional) ---
ENTERPRISE_ADMIN_SECRET=
ENTERPRISE_ACCESS_CODES=

# --- Pembayaran Pakasir (NONAKTIF secara default) ---
PAYMENTS_ENABLED=false
PAKASIR_PROJECT_SLUG=
PAKASIR_API_KEY=
PAKASIR_WEBHOOK_SECRET=

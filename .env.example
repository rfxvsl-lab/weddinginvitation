# ── Wajib ─────────────────────────────────────────────────────────────

# Database Turso. Untuk development lokal bisa memakai file: file:./local.db
TURSO_DATABASE_URL=libsql://your_database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Kunci penanda tangan cookie session. Minimal 32 karakter, acak, dan RAHASIA.
# Buat dengan: openssl rand -base64 48
# Mengganti nilai ini membuat semua user harus login ulang.
SESSION_SECRET=

# URL publik aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Pembayaran (Pakasir) ──────────────────────────────────────────────
PAKASIR_PROJECT_SLUG=your_pakasir_project_slug
PAKASIR_API_KEY=your_pakasir_api_key
# Hanya untuk staging/test (gateway tiruan). KOSONGKAN di production.
# PAKASIR_BASE_URL=

# ── Login Google ──────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# ── Unggah gambar (Cloudinary) ────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# ── Admin ─────────────────────────────────────────────────────────────
# Email akun yang dijadikan admin saat `npm run migrate` dijalankan.
# Hanya dibaca skrip migrasi; aplikasi menentukan admin dari kolom users.role.
ADMIN_EMAIL=your_admin_email@example.com
# Nomor WhatsApp admin, format internasional tanpa "+" (mis. 6281234567890)
NEXT_PUBLIC_ADMIN_WHATSAPP=

# ── Opsional ──────────────────────────────────────────────────────────
# Kunci Gemini untuk fitur AI copywriter. Tanpa ini, editor memakai teks contoh.
# Jangan pernah memakai awalan NEXT_PUBLIC_ untuk kunci ini.
GEMINI_API_KEY=

# ============================================
# Wedding SaaS Builder by RFX.visual
# Environment Variables
# ============================================

# Turso Database
# Get these from: turso db show rfx-wedding-saas --url
#                  turso db tokens create rfx-wedding-saas
VITE_TURSO_DATABASE_URL=libsql://rfx-wedding-saas-your-org.turso.io
VITE_TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Cloudinary (preset terpisah: rfx_wedding)
VITE_CLOUDINARY_CLOUD_NAME=dxklmdbjv
VITE_CLOUDINARY_UPLOAD_PRESET=rfx_wedding

# App URL (domain publik)
VITE_APP_URL=https://undangankita.rfx.web.id

# Gemini API Key (opsional, utama pakai Puter.js)
GEMINI_API_KEY=
